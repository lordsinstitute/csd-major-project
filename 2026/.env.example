# ==============================================================================
# CrewHub Platform Environment Configuration
# ==============================================================================

# Gemini AI API Key (Used on the server for synergy explanation and chat safety moderation)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Application Host URL (Defaults to http://localhost:3000 in development)
APP_URL="http://localhost:3000"

# Server Port
PORT=3000

# Optional Firebase environment overrides (defaults are loaded from firebase-applet-config.json)
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_DATABASE_ID=""
